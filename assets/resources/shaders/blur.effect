CCEffect %{
  techniques:
  - passes:
    - vert: sprite-vs:vert
      frag: sprite-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties: # 材质球上的面板属性
        # type: sampler2D 类型 type: number 类型
        blurThreshold: { value: 0.5 }
}%

CCProgram sprite-vs %{
  //定义float的精度为高精度
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  #if SAMPLE_FROM_RT
    #include <common/common-define>
  #endif

  //cc_matViewProj 引擎根据节点位置等生成的模型到透视的变换矩阵;

  //使用的 顶点参数
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;
  //传递给 片元着色器 的变量
  out vec4 color;
  out vec2 uv0;

  vec4 vert () {
    vec4 pos = vec4(a_position, 1);

    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif

    #if USE_PIXEL_ALIGNMENT
      pos = cc_matView * pos;
      pos.xyz = floor(pos.xyz);
      pos = cc_matProj * pos;
    #else
      pos = cc_matViewProj * pos;
    #endif
    uv0 = a_texCoord;
    #if SAMPLE_FROM_RT
      CC_HANDLE_RT_SAMPLE_FLIP(uv0);
    #endif
    color = a_color;
    return pos;
  }
}%

CCProgram sprite-fs %{
  precision highp float;
  #include <builtin/internal/embedded-alpha>
  #include <builtin/internal/alpha-test>

  in vec4 color;

  in vec2 uv0;
  #pragma builtin(local)
  layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;
  uniform blur {
    float blurThreshold;
  };

  vec4 frag () {
 
    float scale = 40.0 * blurThreshold;
    //告诉模糊
    vec2 blurSize = vec2(scale, scale); 
    vec4 sum = vec4(0.0);
    //GLSL纹理采样函数, CCSampleWithAlphaSeparated 返回一个颜色值;
    sum += CCSampleWithAlphaSeparated(cc_spriteTexture, uv0 - 0.0004 * blurSize) * 0.05;
    sum += CCSampleWithAlphaSeparated(cc_spriteTexture, uv0 - 0.0003 * blurSize) * 0.09;
    sum += CCSampleWithAlphaSeparated(cc_spriteTexture, uv0 - 0.0002 * blurSize) * 0.12;
    sum += CCSampleWithAlphaSeparated(cc_spriteTexture, uv0 - 0.0001 * blurSize) * 0.15;
    sum += CCSampleWithAlphaSeparated(cc_spriteTexture, uv0) * 0.16;
    sum += CCSampleWithAlphaSeparated(cc_spriteTexture, uv0 + 0.0001 * blurSize) * 0.15;
    sum += CCSampleWithAlphaSeparated(cc_spriteTexture, uv0 + 0.0002 * blurSize) * 0.12;
    sum += CCSampleWithAlphaSeparated(cc_spriteTexture, uv0 + 0.0003 * blurSize) * 0.09;
    sum += CCSampleWithAlphaSeparated(cc_spriteTexture, uv0 + 0.0004 * blurSize) * 0.05;
    return color * sum;
  }
}%
